{
  "name": "mnki-verifier",
  "version": "0.1.6",
  "description": "Pure verification core for Agent Trust: request parsing, delegation chain resolution, authority attenuation. No runtime dependencies. Destined for the open-source MNKIAgentOS/agent-trust repo.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MNKIAgentOS/agent-trust.git",
    "directory": "packages/verifier"
  },
  "homepage": "https://mnki.com",
  "bugs": "https://github.com/MNKIAgentOS/agent-trust/issues",
  "keywords": [
    "ai-agents",
    "agent-security",
    "authorization",
    "delegation",
    "spiffe",
    "wimse",
    "authzen",
    "mcp",
    "a2a",
    "jws",
    "dpop",
    "mnki"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
