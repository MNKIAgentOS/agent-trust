{
  "name": "@mnki/sdk",
  "version": "0.1.0",
  "description": "Agent Trust SDK for TypeScript: agent identity (keys + signed requests), verify, delegate, attest, and offline verification of delegation credentials and attestations.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@mnki/verifier": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MNKIAgentOS/agent-trust",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://mnki.com",
  "bugs": "https://github.com/MNKIAgentOS/agent-trust/issues",
  "keywords": [
    "ai-agents",
    "agent-security",
    "authorization",
    "delegation",
    "spiffe",
    "wimse",
    "authzen",
    "mcp",
    "a2a",
    "jws",
    "dpop"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
