{
  "name": "mnki-cli",
  "version": "0.1.2",
  "description": "mnki — init, identity, verify, inspect, delegate, attest, scan, protect (local MCP proxy, dry-run by default), conformance (agenttrust remains an alias). Run with `npm run agenttrust -- <command>` in the monorepo (tsx); packaged bins in the public repo.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "dependencies": {
    "mnki-sdk": "^0.1.2",
    "mnki-verifier": "^0.1.2",
    "mnki-mcp": "^0.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MNKIAgentOS/agent-trust.git",
    "directory": "packages/cli"
  },
  "homepage": "https://mnki.com",
  "bugs": "https://github.com/MNKIAgentOS/agent-trust/issues",
  "keywords": [
    "ai-agents",
    "agent-security",
    "authorization",
    "delegation",
    "spiffe",
    "wimse",
    "authzen",
    "mcp",
    "a2a",
    "jws",
    "dpop",
    "mnki"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "bin": {
    "mnki-cli": "dist/main.js",
    "mnki": "dist/main.js",
    "agenttrust": "dist/main.js"
  }
}
